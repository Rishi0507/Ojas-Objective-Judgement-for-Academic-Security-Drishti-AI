# Copy to .env.local and fill in. .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Custody ledger signing key (server-only, Ed25519 PKCS#8 base64).
# Generate with: npx tsx scripts/ledger-keygen.ts
# Optional - without it entries still chain and stay tamper-evident, they just
# carry no signature proving which server recorded them.
LEDGER_SIGNING_KEY=

# n8n workflow that renders and mails the incident report.
# Production webhook URL of the "drishti report" workflow. Without it the
# Issue report button explains what is missing instead of failing silently.
N8N_REPORT_WEBHOOK=

# Optional: browser used to render report PDFs. Only needed if Chrome and
# Edge are not in their default install locations.
CHROME_PATH=

# Keep optical flow and motion masks after a run. Off by default: they are
# ~79% of a job on disk and nothing reads them after Module 7. Set to 1 only
# when re-running Modules 4-6 without redoing Module 3.
KEEP_INTERMEDIATES=
