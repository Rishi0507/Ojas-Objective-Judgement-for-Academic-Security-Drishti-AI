# Copy to .env.local and fill in. .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Custody ledger signing key (server-only, Ed25519 PKCS#8 base64).
# Generate with: npx tsx scripts/ledger-keygen.ts
# Optional - without it entries still chain and stay tamper-evident, they just
# carry no signature proving which server recorded them.
LEDGER_SIGNING_KEY=
