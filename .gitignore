/pipeline_out/


# model weights — fetch via scripts/setup_yolo.ps1 / download_yolo_model.ps1
*.pt
*.onnx

# compiled Go backend binary — rebuild with `go build` in m8_9_golang/
m8_9_golang/*.exe
